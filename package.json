{
  "name": "tokenhub-desktop",
  "version": "1.0.0",
  "description": "TokenHub P2P Token Exchange Desktop App",
  "main": ".vite/build/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "bunx electron-forge start",
    "build:main": "bunx vite build --config vite.main.config.ts",
    "build:preload": "bunx vite build --config vite.preload.config.ts",
    "build:renderer": "bunx vite build --config vite.renderer.config.ts",
    "build:app": "bun run build:main && bun run build:preload && bun run build:renderer",
    "build": "bunx electron-forge package",
    "make": "bunx electron-forge make",
    "test": "bunx vitest",
    "test:run": "bunx vitest run",
    "test:coverage": "bunx vitest run --coverage.enabled --coverage.provider=v8 --coverage.all --coverage.reportsDirectory=coverage/vitest --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=json --coverage.reporter=lcovonly --coverage.include=\"src/main/**/*.ts\" --coverage.include=\"src/shared/**/*.ts\" --coverage.include=\"src/renderer/**/*.ts\" --coverage.include=\"src/renderer/**/*.tsx\" --coverage.exclude=\"**/*.test.ts\" --coverage.exclude=\"**/*.test.tsx\" --coverage.exclude=\"src/main/index.ts\" --coverage.exclude=\"src/main/testing/**/*.ts\"",
    "test:ui": "bunx vitest --ui",
    "e2e": "bunx playwright test",
    "e2e:coverage": "bun scripts/coverage/run-e2e-coverage.mjs",
    "e2e:headed": "bunx playwright test --headed",
    "coverage:check": "bun scripts/coverage/check-thresholds.mjs",
    "coverage:comment": "bun scripts/coverage/build-comment.mjs",
    "lint": "bunx eslint src --ext .ts,.tsx",
    "typecheck": "bunx tsc --noEmit -p tsconfig.typecheck.json"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.4.0",
    "@electron-forge/maker-deb": "^7.4.0",
    "@electron-forge/maker-dmg": "^7.4.0",
    "@electron-forge/maker-rpm": "^7.4.0",
    "@electron-forge/maker-squirrel": "^7.4.0",
    "@electron-forge/maker-zip": "^7.4.0",
    "@electron-forge/plugin-vite": "^7.4.0",
    "@playwright/test": "^1.43.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^15.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20.12.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.5.0",
    "@vitest/ui": "^1.5.0",
    "electron": "^30.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "happy-dom": "^14.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.5.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.29.0",
    "fastify": "^4.26.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.19.0",
    "zod": "^3.22.0",
    "zustand": "^4.5.0"
  },
  "keywords": ["tokenhub", "p2p", "llm", "tokens", "exchange"],
  "author": "TokenHub Team",
  "license": "MIT",
  "config": {
    "forge": {
      "packagerConfig": {},
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "tokenhub"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": ["darwin"]
        },
        {
          "name": "@electron-forge/maker-dmg",
          "config": {
            "format": "ULFO"
          }
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ],
      "plugins": [
        {
          "name": "@electron-forge/plugin-vite",
          "config": {
            "build": [
              {
                "entry": "src/main/index.ts",
                "config": "vite.main.config.ts"
              },
              {
                "entry": "src/preload/index.ts",
                "config": "vite.preload.config.ts"
              }
            ],
            "renderer": [
              {
                "name": "main_window",
                "config": "vite.renderer.config.ts"
              }
            ]
          }
        }
      ]
    }
  }
}
